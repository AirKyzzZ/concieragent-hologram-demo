# Concieragent Environment Variables
# Copy this file to .env and fill in your actual API keys

# OpenAI API Key (required for GPT-4o orchestration)
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# SerpAPI Key (required for flight, hotel, event, and finance searches)
# Get your key from: https://serpapi.com/
# Free tier: 100 searches/month
SERPAPI_KEY=your-serpapi-key-here

# VS Agent Admin API URL (optional, defaults to http://localhost:3000)
# Only change if VS Agent is running on a different host/port
VS_AGENT_URL=http://localhost:3000

# OpenWeatherMap API Key (required for weather searches - works internationally)
# Get your free key from: https://openweathermap.org/api
OPENWEATHER_API_KEY=your-openweather-api-key-here
