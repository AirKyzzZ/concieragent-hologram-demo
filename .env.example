# Concieragent Environment Variables
# Copy this file to .env and fill in your actual API keys

# Docker Hub (required for deployment)
DOCKER_HUB_LOGIN=your-dockerhub-username
DOCKER_HUB_PWD=your-dockerhub-password-or-token

# Kubernetes (required for deployment)
KUBECONFIG=<base64-encoded-kubeconfig>

# ═══════════════════════════════════════════════════════════════════════════════
# Storage Configuration
# ═══════════════════════════════════════════════════════════════════════════════

# Choose storage provider: 'memory' or 'postgres'
# - memory: In-memory storage (data lost on restart, good for local dev)
# - postgres: PostgreSQL storage (persistent, recommended for production)
STORAGE_PROVIDER=memory

# Session expiration (in days) - how long inactive sessions are retained
SESSION_EXPIRATION_DAYS=7

# PostgreSQL Configuration (required if STORAGE_PROVIDER=postgres)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=concieragent
POSTGRES_USER=concieragent
POSTGRES_PASSWORD=

# Redis Configuration (optional, improves performance with postgres storage)
REDIS_HOST=
REDIS_PORT=6379
# REDIS_PASSWORD=

# ═══════════════════════════════════════════════════════════════════════════════
# LLM Provider Configuration
# ═══════════════════════════════════════════════════════════════════════════════

# Choose provider: 'openai', 'claude', or 'ollama'
LLM_PROVIDER=openai

# OpenAI (default)
OPENAI_API_KEY=your-key
# OPENAI_MODEL=gpt-4o  # optional

# Claude
ANTHROPIC_API_KEY=your-key
# CLAUDE_MODEL=claude-sonnet-4-20250514  # optional

# Ollama (no API key needed, just run 'ollama serve')
# OLLAMA_BASE_URL=http://localhost:11434  # optional
# OLLAMA_MODEL=llama3.1  # optional

# SerpAPI Key (required for flight, hotel, event, and finance searches)
# Get your key from: https://serpapi.com/
# Free tier: 100 searches/month
SERPAPI_KEY=your-key

# VS Agent Admin API URL (optional, defaults to http://localhost:3000)
# Only change if VS Agent is running on a different host/port
VS_AGENT_URL=http://localhost:3000

OPENWEATHER_API_KEY=your-key
