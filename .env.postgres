# PostgreSQL storage configuration for local development
# Copy this to .env or use: cp .env.postgres .env

# Storage Configuration
STORAGE_PROVIDER=postgres
SESSION_EXPIRATION_DAYS=7

# PostgreSQL (docker-compose)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=concieragent
POSTGRES_USER=concieragent
POSTGRES_PASSWORD=localdev

# Redis (docker-compose)
REDIS_HOST=localhost
REDIS_PORT=6379

# LLM Configuration (fill in your keys)
LLM_PROVIDER=openai
OPENAI_API_KEY=

# MCP Tools (fill in your keys)
SERPAPI_KEY=
OPENWEATHER_API_KEY=

# VS Agent
VS_AGENT_URL=http://localhost:3000
